# Copy to .env and fill in. Never commit .env.
GATEWAY_CONFIG=config/gateway.yaml
REDIS_URL=redis://redis:6379/0
# Hosted fallback provider (free tiers: Groq, Gemini via OpenAI-compatible endpoint, OpenRouter)
GROQ_API_KEY=
# Admin key for /admin endpoints
ADMIN_API_KEY=change-me
# Hugging Face token (only needed for gated models like Llama)
HF_TOKEN=
